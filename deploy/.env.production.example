# Copy to deploy/.env.production and fill in every CHANGE-ME. Never commit
# deploy/.env.production (it is in .gitignore).
#
# This file is read two ways:
#   - docker compose --env-file deploy/.env.production  → interpolates
#     ${VARS} inside docker/compose/prod.yml (POSTGRES_*, WEB_PORT, ...) and,
#     via each service's `env_file:`, becomes real environment variables
#     inside the web/realtime containers.
#   - deploy/systemd/ambatucode-worker.service's EnvironmentFile= → the same
#     values, for the worker process running natively on the host.
#
# web and realtime are on the compose network, so they reach Postgres/Redis
# by Docker's service-name DNS (postgres, redis) below. The worker is native
# and cannot use those hostnames — its systemd unit overrides REDIS_URL and
# EXECUTION_CALLBACK_URL to the host-published equivalents. Do not "fix" the
# values below to be host-reachable; that would break web/realtime instead.

# --- Shared infrastructure (container perspective — see note above) ---
DATABASE_URL="postgresql://ambatucode:CHANGE-ME@postgres:5432/ambatucode?schema=public"
REDIS_URL="redis://redis:6379"

# Read directly by docker/compose/prod.yml to create the postgres container.
# Must match the password embedded in DATABASE_URL above.
POSTGRES_USER=ambatucode
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=ambatucode

# --- Secrets ---
# Generate with: openssl rand -hex 32
# Both must be freshly generated for this deployment and must differ from
# each other (the worker has no business calling apps/web's internal
# endpoints, so it must not hold INTERNAL_API_SECRET).
EXECUTION_CALLBACK_SECRET="CHANGE-ME-32-CHARS-MINIMUM"
INTERNAL_API_SECRET="CHANGE-ME-DIFFERENT-32-CHARS-MINIMUM"

# --- apps/web ---
WEB_PORT=3000
# Public, browser-facing. Baked into the client bundle at image build time
# (see docker/app/web.Dockerfile) — changing it here after the image is
# already built has no effect until you rebuild.
NEXT_PUBLIC_REALTIME_URL="https://realtime.CHANGE-ME.example.com"
SESSION_TTL_HOURS=12
# Leave unset (commented out) when served over HTTPS through the reverse
# proxy, which is the expected production setup — NODE_ENV=production makes
# this default to true. Only set it to false for a deliberate plain-HTTP LAN
# deployment with no TLS in front.
# SESSION_COOKIE_SECURE=false
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- apps/realtime ---
REALTIME_PORT=3001
# Public, browser-facing origin apps/web is actually served from. Checked
# against the Origin header on every socket handshake.
REALTIME_CORS_ORIGIN="https://app.CHANGE-ME.example.com"
# Server-to-server, container perspective: apps/realtime calls apps/web's
# internal endpoints by the web service's Docker DNS name.
WEB_INTERNAL_URL="http://web:3000"

# --- apps/worker ---
# Container-perspective value, correct for reference/documentation only —
# the worker itself overrides this in ambatucode-worker.service, because it
# calls back to apps/web from the host, not from inside the compose network.
EXECUTION_CALLBACK_URL="http://web:3000/api/internal/execution/result"
WORKER_HEALTH_ADDR=":3002"
WORKER_LOG_LEVEL="info"
# WORKER_CONCURRENCY=8
# WORKER_MAX_CONTAINERS=8
# WORKER_SUBMIT_RESERVED_CONTAINERS=2
# WORKER_LOCK_DURATION_MS=30000
# WORKER_STALLED_INTERVAL_MS=30000
# WORKER_MAX_STALLED_COUNT=1
# WORKER_SHUTDOWN_GRACE_MS=30000
# WORKER_QUEUE_PREFIX="bull"

# --- seed (only used if you run db:seed) ---
SEED_DEFAULT_PASSWORD="CHANGE-ME"
