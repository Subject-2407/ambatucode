[Unit]
Description=Ambatucode web/realtime/postgres/redis (docker compose)
After=docker.service
Requires=docker.service

# Also a systemd --user unit (see ambatucode-worker.service) — install it
# the same way, as the same user:
#
#   mkdir -p ~/.config/systemd/user
#   sed 's#/opt/ambatucode#/absolute/path/to/this/checkout#g' \
#     deploy/systemd/ambatucode-stack.service > ~/.config/systemd/user/ambatucode-stack.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now ambatucode-stack
#
# Every container in prod.yml already has restart: unless-stopped, so it
# survives a reboot on its own once this user's rootless Docker starts
# (which needs linger enabled — see ambatucode-worker.service). This unit
# exists purely so the stack can be started/stopped/inspected the same way
# as ambatucode-worker (systemctl --user status/start/stop
# ambatucode-stack), not because compose needs systemd to keep it running.

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/opt/ambatucode
Environment=DOCKER_HOST=unix://%t/docker.sock
ExecStart=/usr/bin/docker compose -f docker/compose/prod.yml --env-file deploy/.env.production up -d
ExecStop=/usr/bin/docker compose -f docker/compose/prod.yml --env-file deploy/.env.production down

[Install]
WantedBy=default.target
