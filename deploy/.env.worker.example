# Copy to deploy/.env.worker and fill in. Never commit deploy/.env.worker
# (it is in .gitignore).
#
# The worker runs natively on the host (deploy/systemd/ambatucode-worker.
# service), not inside docker/compose/prod.yml's network — so unlike
# deploy/.env.production (written for the web/realtime containers, which
# reach Postgres/Redis by Docker service name), these two values need the
# host-published addresses instead. Keep them in sync by hand whenever
# REDIS_HOST_PORT or WEB_PORT changes in deploy/.env.production.

# Must match REDIS_HOST_PORT in deploy/.env.production (default 6380, not
# Redis's usual 6379 — see that file for why).
REDIS_URL="redis://127.0.0.1:6380"

# Must match WEB_PORT in deploy/.env.production (default 3000).
EXECUTION_CALLBACK_URL="http://127.0.0.1:3000/api/internal/execution/result"
