# Copy to .env and adjust. Never commit .env.

# --- Shared infrastructure ---
DATABASE_URL="postgresql://ambatucode:ambatucode@127.0.0.1:5433/ambatucode?schema=public"
REDIS_URL="redis://localhost:6379"

# --- Secrets ---
# 32+ chars. Signs the worker result callback token.
EXECUTION_CALLBACK_SECRET="dev-only-execution-callback-secret-change-me"
# 32+ chars. Held by apps/web and apps/realtime only. Signs the calls apps/realtime
# makes to apps/web's internal assessment endpoints (deadline auto-submit). Must
# differ from the callback secret: the worker has no business making these calls.
INTERNAL_API_SECRET="dev-only-internal-api-secret-change-me-too"

# --- apps/web ---
# NODE_ENV is intentionally unset: Next.js sets it per command (development for
# `next dev`, production for `next build` / `next start`). Pinning it here makes
# production builds run with development semantics.
WEB_PORT=3000
# Browser-visible: where the Socket.IO client connects. It is resolved by the
# client machine, so a LAN deployment needs a real host here, not localhost.
NEXT_PUBLIC_REALTIME_URL="http://localhost:3001"
SESSION_TTL_HOURS=12
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- apps/realtime ---
REALTIME_PORT=3001
REALTIME_CORS_ORIGIN="http://localhost:3000"
# Server-to-server: where apps/realtime reaches apps/web's internal endpoints.
WEB_INTERNAL_URL="http://localhost:3000"

# --- apps/worker ---
# Every value below has a working default; they are listed so the knobs are
# discoverable. The worker holds no database credentials by design — it reaches
# PostgreSQL only by posting results to the callback below.
EXECUTION_CALLBACK_URL="http://localhost:3000/api/internal/execution/result"
WORKER_HEALTH_ADDR=":3002"
WORKER_LOG_LEVEL="info"
# Goroutines in the pool. Defaults to min(numCPU * 2, 16).
# WORKER_CONCURRENCY=8
# Caps concurrently running containers, which cost far more than a goroutine.
# Must not exceed WORKER_CONCURRENCY, or the extra slots can never be claimed.
# WORKER_MAX_CONTAINERS=8
# Container slots practice runs may never take, so a flood of runs cannot
# starve formal submissions. Defaults to a quarter of WORKER_MAX_CONTAINERS
# (at least 1, or 0 on a single-slot worker). Must stay below it.
# WORKER_SUBMIT_RESERVED_CONTAINERS=2
# How long a claimed job stays owned before BullMQ treats it as stalled. Running
# jobs renew it every half duration, so a long compile keeps its job.
# WORKER_LOCK_DURATION_MS=30000
# How often jobs abandoned by a crashed worker are returned to their queue, and
# how many times one job may be rescued that way before it is failed instead.
# Both default to BullMQ's own worker settings.
# WORKER_STALLED_INTERVAL_MS=30000
# WORKER_MAX_STALLED_COUNT=1
# How long in-flight jobs get to finish on SIGTERM before they are handed back.
# WORKER_SHUTDOWN_GRACE_MS=30000
# BullMQ's Redis key prefix. Must match the producer's.
# WORKER_QUEUE_PREFIX="bull"

# --- seed ---
SEED_DEFAULT_PASSWORD="Ambatucode123!"
