{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/vendor-monaco.mjs && dotenv -e ../../.env -- next dev --port 3000",
    "build": "node scripts/vendor-monaco.mjs && dotenv -e ../../.env -- next build",
    "start": "dotenv -e ../../.env -- next start --port 3000",
    "typecheck": "tsc --noEmit",
    "test:integration": "dotenv -e ../../.env -- vitest run --config vitest.integration.config.ts",
    "stub:worker": "dotenv -e ../../.env -- tsx scripts/stub-execution-worker.ts",
    "enqueue:sample": "dotenv -e ../../.env -- node --conditions=react-server --import tsx scripts/enqueue-sample-job.ts",
    "vendor:monaco": "node scripts/vendor-monaco.mjs"
  },
  "dependencies": {
    "@ambatucode/db": "workspace:*",
    "@ambatucode/shared": "workspace:*",
    "@chakra-ui/react": "^3.37.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@monaco-editor/react": "^4.7.0",
    "@node-rs/argon2": "^2.2.0",
    "@tanstack/react-query": "^5.102.8",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "bullmq": "^5.81.4",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.41.0",
    "monaco-editor": "^0.56.0",
    "next": "^15.5.25",
    "next-themes": "~0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "socket.io-client": "4.8.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
