{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev --port 3000",
    "build": "dotenv -e ../../.env -- next build",
    "start": "dotenv -e ../../.env -- next start --port 3000",
    "typecheck": "tsc --noEmit",
    "test:integration": "dotenv -e ../../.env -- vitest run --config vitest.integration.config.ts",
    "stub:worker": "dotenv -e ../../.env -- tsx scripts/stub-execution-worker.ts",
    "enqueue:sample": "dotenv -e ../../.env -- node --conditions=react-server --import tsx scripts/enqueue-sample-job.ts"
  },
  "dependencies": {
    "@ambatucode/db": "workspace:*",
    "@ambatucode/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.0",
    "bullmq": "^5.81.4",
    "ioredis": "^5.11.1",
    "next": "^15.5.25",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "dotenv-cli": "^11.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "tsx": "^4.23.13"
  }
}
